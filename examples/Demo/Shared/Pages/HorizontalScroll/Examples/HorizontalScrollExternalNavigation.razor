<FluentHorizontalScroll @ref="_horizontalScroll" Speed="600" Easing=ScrollEasing.EaseInOut>
    <GCard>Card number 1</GCard>
    <GCard>Card number 2</GCard>
    <GCard>Card number 3</GCard>
    <GCard>Card number 4</GCard>
    <GCard>Card number 5</GCard>
    <GCard>Card number 6</GCard>
    <GCard>Card number 7</GCard>
    <GCard>Card number 8</GCard>
    <GCard>Card number 9</GCard>
    <GCard>Card number 10</GCard>
    <GCard>Card number 11</GCard>
    <GCard>Card number 12</GCard>
    <GCard>Card number 13</GCard>
    <GCard>Card number 14</GCard>
    <GCard>Card number 15</GCard>
    <GCard>Card number 16</GCard>
</FluentHorizontalScroll>

<GButton @onclick="() => _horizontalScroll.ScrollToPrevious()">Scroll to Previous</GButton>
<GButton @onclick="() => _horizontalScroll.ScrollToNext()">Scroll to Next</GButton>
<GButton @onclick="() => _horizontalScroll.ScrollInView(10)">Scroll to 10</GButton>

@code {
    FluentHorizontalScroll _horizontalScroll = default!;
}
