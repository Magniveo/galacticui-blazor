<FluentAccordion>
    <FluentAccordionItem Heading="@($"Just an item (status: {(accordionOpen ? "open" : "closed")})")" @bind-Expanded="@accordionOpen">
        This accordion item can programatically be opened and closed. Use the buttons below to manipulate the state
    </FluentAccordionItem>
</FluentAccordion>

<GButton OnClick="OpenAccordion">Open</GButton>
<GButton OnClick="CloseAccordion">Close</GButton>
<GButton OnClick="ToggleAccordion">Toggle</GButton>


@code
{
    private bool accordionOpen = false;

    private void OpenAccordion()
    {
        accordionOpen = true;
    }

    private void CloseAccordion()
    {
        accordionOpen = false;
    }

    private void ToggleAccordion()
    {
        accordionOpen = !accordionOpen;
    }
}
