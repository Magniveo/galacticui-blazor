<FluentStack HorizontalGap="10">
    <GButton>Button</GButton>
    <GButton Appearance="Appearance.Accent">Accent</GButton>
    <GButton Appearance="Appearance.Lightweight">Lightweight</GButton>
    <GButton Appearance="Appearance.Outline">Outline</GButton>
    <GButton Appearance="Appearance.Stealth">Stealth</GButton>
    <GButton BackgroundColor="var(--highlight-bg)" Color="var(--info)">Colored</GButton>
    <GButton Loading="@loading" OnClick="@StartLoadingAsync" Appearance="Appearance.Accent">Loading</GButton>
</FluentStack>

@code {

    bool loading = false;

    async Task StartLoadingAsync()
    {
        loading = true;
        await DataSource.WaitAsync(2000, () => loading = false);
    }
}
